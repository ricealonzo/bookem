<% content_for :title, "Booking at #{@booking.location.name}" %>

<div class="narrow">
  <header class="page-header">
    <h1>Booking</h1>
  </header>

  <%= render @booking %>

  <p class="booking-explainer">
    <% case @booking.status %>
    <% when "pending" %>
      <% if @booking.deposit_awaiting? && @booking.active? %>
        Pay the <%= @booking.deposit_label %> deposit to send your request.
        This time is held for you until <%= short_time(@booking.payment_expires_at.in_time_zone) %>.
      <% elsif @booking.deposit_awaiting? %>
        The deposit wasn't paid in time, so this time was released.
      <% else %>
        Waiting for the host to confirm or decline.
      <% end %>
    <% when "confirmed" %>
      Confirmed by the host.
    <% when "declined" %>
      The host declined this request.
    <% when "cancelled" %>
      This booking was cancelled.
    <% end %>
  </p>

  <% if @booking.deposit_paid? && @booking.guest_id == current_user.id && @booking.cancellable? %>
    <% refund_until = @booking.started_at - Deposits::FREE_CANCELLATION %>
    <p class="deposit-note">
      Your <%= @booking.deposit_label %> deposit is paid.
      Cancel before <%= refund_until.strftime("%a, %b %-d") %> at <%= short_time(refund_until) %> to get it back.
    </p>
  <% end %>

  <div class="booking-actions">
    <% if policy(@booking).pay? %>
      <%= button_to "Pay deposit", pay_booking_path(@booking), method: :post, class: "button", data: { turbo: false } %>
    <% end %>
    <% if policy(@booking).confirm? %>
      <%= button_to "Confirm", confirm_booking_path(@booking), method: :patch, class: "button" %>
      <%= button_to "Decline", decline_booking_path(@booking), method: :patch, class: "button button-quiet" %>
    <% end %>

    <% if policy(@booking).update? %>
      <%= link_to "Change times", edit_booking_path(@booking), class: "button button-quiet" %>
    <% end %>

    <% if policy(@booking).cancel? %>
      <%= button_to "Cancel booking", cancel_booking_path(@booking), method: :patch, class: "button button-danger",
            data: { confirm: "Cancel this booking?" } %>
    <% end %>
  </div>

  <p class="back-link"><%= link_to "Back to bookings", bookings_path %></p>
</div>
