<article id="<%= dom_id booking %>" class="booking booking-<%= booking.status %>">
  <div class="booking-head">
    <h3 class="booking-place"><%= link_to booking.location.name, booking.location %></h3>
    <span class="status-badge status-<%= booking.status %>"><%= booking.status.capitalize %></span>
  </div>

  <p class="booking-when">
    <% if booking.started_at && booking.ended_at %>
      <%= booking_range_label(booking) %>
    <% else %>
      Time not set
    <% end %>
  </p>

  <p class="booking-who">
    <% if booking.location.hosted_by?(current_user) %>
      Guest: <%= booking.guest.full_name.presence || "Guest" %> (<%= mail_to booking.guest.email %>)
    <% else %>
      Host: <%= booking.location.host.full_name.presence || "Bookem host" %>
    <% end %>
  </p>

  <% if local_assigns[:show_link] %>
    <%= link_to "View booking", booking, class: "booking-link" %>
  <% end %>
</article>
