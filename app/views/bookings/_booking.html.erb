<div id="<%= dom_id booking %>" class="card h-100 booking-card">
  <div class="card-body">
    <h5 class="card-title">
      <%= link_to booking.location.name, booking.location %>
      <span class="booking-status booking-status-<%= booking.status %>"><%= booking.status.capitalize %></span>
    </h5>

    <p class="card-text mb-2">
      <strong>From:</strong>
      <%= l(booking.started_at, format: :long) if booking.started_at %>
    </p>
    <p class="card-text mb-2">
      <strong>To:</strong>
      <%= l(booking.ended_at, format: :long) if booking.ended_at %>
    </p>

    <% if booking.location.hosted_by?(current_user) %>
      <p class="card-text mb-0">
        <strong>Guest:</strong>
        <%= booking.guest.full_name.presence || "Guest" %>
        (<%= mail_to booking.guest.email %>)
      </p>
    <% else %>
      <p class="card-text mb-0">
        <strong>Host:</strong>
        <%= booking.location.host.full_name.presence || "Bookem host" %>
      </p>
    <% end %>
  </div>

  <% if local_assigns[:show_link] %>
    <div class="card-footer bg-transparent border-top-0">
      <%= link_to "View booking", booking, class: "btn btn-sm btn-primary" %>
    </div>
  <% end %>
</div>
