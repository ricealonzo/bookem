<%= form_with(model: booking, class: "booking-form") do |form| %>
  <h2><%= booking.persisted? ? "Change Booking Times" : "Request a time" %></h2>

  <% if booking.errors.any? %>
    <div class="form-errors" role="alert">
      <p>This booking couldn't be saved:</p>
      <ul>
        <% booking.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% unless booking.persisted? %>
    <p class="form-intro">at <strong><%= booking.location.name %></strong></p>
  <% end %>

  <% min_time = Time.current.strftime("%Y-%m-%dT%H:%M") %>

  <div class="field">
    <%= form.label :started_at, "Start" %>
    <%= form.datetime_field :started_at, min: min_time, required: true, data: { booking_picker_target: "start" } %>
  </div>

  <div class="field">
    <%= form.label :ended_at, "End" %>
    <%= form.datetime_field :ended_at, min: min_time, required: true, data: { booking_picker_target: "end" } %>
  </div>

  <% unless booking.persisted? %>
    <%= form.hidden_field :location_id, value: booking.location_id %>
  <% end %>

  <%= form.submit booking.persisted? ? "Save Changes" : "Request Booking", class: "button button-wide" %>

  <% unless booking.persisted? %>
    <p class="form-hint">The host confirms or declines your request. You can cancel any time before it starts.</p>
  <% end %>
<% end %>
