<%= form_with(model: booking, class: "booking_form") do |form| %>
  <h2><%= booking.persisted? ? "Change Booking Times" : "Book Now" %></h2>

  <% if booking.errors.any? %>
    <div class="form-errors" role="alert">
      <h3><%= pluralize(booking.errors.count, "problem") %> with this booking:</h3>
      <ul>
        <% booking.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>You are booking <strong><%= booking.location.name %></strong>.</p>

  <% min_time = Time.current.strftime("%Y-%m-%dT%H:%M") %>

  <div class="mb-3">
    <%= form.label :started_at, "Start" %>
    <%= form.datetime_field :started_at, class: "form-control", min: min_time, required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :ended_at, "End" %>
    <%= form.datetime_field :ended_at, class: "form-control", min: min_time, required: true %>
  </div>

  <% unless booking.persisted? %>
    <%= form.hidden_field :location_id, value: booking.location_id %>
    <p class="form-hint">The host will confirm or decline your request.</p>
  <% end %>

  <div>
    <%= form.submit booking.persisted? ? "Save Changes" : "Request Booking" %>
  </div>
<% end %>
