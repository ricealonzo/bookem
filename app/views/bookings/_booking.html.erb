<article id="<%= dom_id booking %>" class="booking booking-<%= booking.status %>">
  <div class="booking-head">
    <h3 class="booking-place"><%= link_to booking.location.name, booking.location %></h3>
    <span class="status-badge status-<%= booking.status %>"><%= booking.status.capitalize %></span>
  </div>

  <p class="booking-when">
    <% if booking.started_at && booking.ended_at %>
      <%= booking_range_label(booking) %>
    <% else %>
      Time not set
    <% end %>
  </p>

  <% details = [] %>
  <% details << booking.service.name if booking.service %>
  <% details << "#{booking.location.resource_label}: #{booking.resource.name}" if booking.resource && booking.resource.name != Resource::DEFAULT_NAME %>
  <% details << booking.price_label if booking.price_label %>
  <% if booking.deposit_label %>
    <% details << { "awaiting" => "#{booking.deposit_label} deposit due", "paid" => "#{booking.deposit_label} deposit paid",
                    "refunded" => "#{booking.deposit_label} deposit refunded", "expired" => "Deposit not paid" }[booking.payment_status] %>
  <% end %>
  <% if details.any? %>
    <p class="booking-extra"><%= details.join(" · ") %></p>
  <% end %>

  <p class="booking-who">
    <% if booking.location.hosted_by?(current_user) %>
      Guest: <%= booking.guest.full_name.presence || "Guest" %> (<%= mail_to booking.guest.email %>)
    <% else %>
      Host: <%= booking.location.host.full_name.presence || "Bookem host" %>
    <% end %>
  </p>

  <div class="booking-foot">
    <% if local_assigns[:actions] && policy(booking).confirm? %>
      <%= button_to "Confirm", confirm_booking_path(booking), method: :patch, class: "button button-small" %>
      <%= button_to "Decline", decline_booking_path(booking), method: :patch, class: "button button-small button-quiet" %>
    <% end %>
    <% if local_assigns[:show_link] %>
      <%= link_to "View booking", booking, class: "booking-link" %>
    <% end %>
  </div>
</article>
