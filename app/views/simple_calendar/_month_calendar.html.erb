<div class="simple-calendar month-calendar">
  <div class="calendar-heading">
    <h3 class="calendar-title">
      <time datetime="<%= start_date.strftime('%Y-%m') %>"><%= t('date.month_names')[start_date.month] %> <%= start_date.year %></time>
    </h3>

    <nav class="calendar-nav" aria-label="Change month">
      <%= link_to calendar.url_for_previous_view, class: "calendar-nav-button", aria: { label: "Previous month" } do %>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <% end %>
      <%= link_to "This month", calendar.url_for_today_view, class: "calendar-nav-today" %>
      <%= link_to calendar.url_for_next_view, class: "calendar-nav-button", aria: { label: "Next month" } do %>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <% end %>
    </nav>
  </div>

  <table class="calendar-grid">
    <thead>
      <tr>
        <% date_range.slice(0, 7).each do |day| %>
          <th scope="col">
            <abbr title="<%= t('date.day_names')[day.wday] %>"><%= t('date.abbr_day_names')[day.wday] %></abbr>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% date_range.each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <%= content_tag :td, class: calendar.td_classes_for(day) do %>
              <% instance_exec(day, calendar.sorted_events_for(day), &passed_block) %>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
