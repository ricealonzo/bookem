<% content_for :title, "Bookings" %>

<header class="page-header">
  <h1>Bookings</h1>
</header>

<section class="bookings-section" aria-labelledby="requests-heading">
  <h2 id="requests-heading">Requests for your locations</h2>
  <% if @requests.any? %>
    <ul id="booking_requests" class="booking-list">
      <% @requests.each do |booking| %>
        <li>
          <%= render booking, show_link: true %>
          <% if policy(booking).confirm? %>
            <div class="booking-actions">
              <%= button_to "Confirm", confirm_booking_path(booking), method: :patch, class: "button button-small" %>
              <%= button_to "Decline", decline_booking_path(booking), method: :patch, class: "button button-small button-quiet" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">No one has requested your locations yet. <%= link_to "List your space", new_location_path %> to start hosting.</p>
  <% end %>
</section>

<section class="bookings-section" aria-labelledby="trips-heading">
  <h2 id="trips-heading">Your trips</h2>
  <% if @trips.any? %>
    <ul id="bookings" class="booking-list">
      <% @trips.each do |booking| %>
        <li><%= render booking, show_link: true %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">You haven't booked anything yet. <%= link_to "Browse locations", locations_path %> to find a space.</p>
  <% end %>
</section>
