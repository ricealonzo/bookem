<% content_for :title, "Your profile" %>

<div class="narrow form-page auth-page">
  <header class="page-header">
    <h1>Your profile</h1>
  </header>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field-row">
      <div class="field">
        <%= f.label :first_name %>
        <%= f.text_field :first_name, autocomplete: "given-name" %>
      </div>
      <div class="field">
        <%= f.label :last_name %>
        <%= f.text_field :last_name, autocomplete: "family-name" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, autocomplete: "email" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="field-hint">Waiting for you to confirm <%= resource.unconfirmed_email %>.</p>
    <% end %>

    <div class="field">
      <%= f.label :organization, "Business name" %>
      <%= f.text_field :organization, autocomplete: "organization" %>
    </div>

    <div class="field-row">
      <div class="field">
        <%= f.label :phone_number %>
        <%= f.telephone_field :phone_number, autocomplete: "tel" %>
      </div>
      <div class="field">
        <%= f.label :website %>
        <%= f.url_field :website, autocomplete: "url" %>
      </div>
    </div>

    <fieldset class="form-group">
      <legend>Change password</legend>
      <div class="field">
        <%= f.label :password, "New password" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <p class="field-hint">Leave blank to keep your current password.<% if @minimum_password_length %> At least <%= @minimum_password_length %> characters.<% end %></p>
      </div>
      <div class="field">
        <%= f.label :password_confirmation, "Confirm new password" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>
    </fieldset>

    <div class="field">
      <%= f.label :current_password %>
      <%= f.password_field :current_password, autocomplete: "current-password", required: true %>
      <p class="field-hint">Needed to save any changes.</p>
    </div>

    <%= f.submit "Save Changes", class: "button button-wide" %>
  <% end %>

  <section class="danger-zone">
    <h2>Delete account</h2>
    <p>This removes your account, your locations and your bookings.</p>
    <%= button_to "Delete my account", registration_path(resource_name), method: :delete, class: "button button-danger",
          data: { confirm: "Delete your account, locations and bookings? This can't be undone." } %>
  </section>
</div>
