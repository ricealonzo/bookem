<% content_for :title, @location.name %>

<article class="location-page">
  <header class="location-header">
    <h1><%= @location.name %></h1>
    <p class="location-place"><%= @location.full_address %></p>
  </header>

  <div class="location-layout">
    <div class="location-main">
      <figure class="location-photo">
        <% if @location.image? %>
          <%= image_tag @location.image.url, alt: "Photo of #{@location.name}" %>
        <% else %>
          <span class="photo-placeholder" aria-hidden="true"><%= @location.name.first %></span>
        <% end %>
      </figure>

      <% if @location.description.present? %>
        <p class="location-description"><%= @location.description %></p>
      <% end %>

      <dl class="location-facts">
        <div>
          <dt>Address</dt>
          <dd><%= @location.full_address.presence || "Not listed" %></dd>
        </div>
        <div>
          <dt>Hosted by</dt>
          <dd><%= @location.host.full_name.presence || "Bookem host" %><%= " (#{@location.host.organization})" if @location.host.organization.present? %></dd>
        </div>
      </dl>
    </div>

    <section class="location-map-section" aria-label="Map">
      <div
        id="map"
        class="location-map"
        data-address="<%= @location.full_address %>"
        data-mapbox-token="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", "") %>">
      </div>
    </section>

    <aside class="booking-panel">
      <h2><%= @location.hosted_by?(current_user) ? "Your Location" : "Book this space" %></h2>
      <p class="panel-note">Booked in <%= slot_length_adjective(@location.slot_minutes) %> slots. Times are Central Time.</p>

      <table class="hours-summary">
        <caption class="visually-hidden">Opening hours</caption>
        <tbody>
          <% weekly_hours_summary(@location).each do |days, hours| %>
            <tr class="<%= "is-closed" if hours == "Closed" %>">
              <th scope="row"><%= days %></th>
              <td><%= hours %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @location.hosted_by?(current_user) %>
        <p>Guests' requests show up on your <%= link_to "Bookings", bookings_path %> page, where you can confirm or decline them.</p>
        <div class="panel-actions">
          <% if policy(@location).update? %>
            <%= link_to "Edit location and hours", edit_location_path(@location), class: "button button-quiet" %>
          <% end %>
          <% if policy(@location).destroy? %>
            <%= button_to "Delete location", @location, method: :delete, class: "button button-danger",
                  data: { confirm: "Delete this location and all its bookings?" } %>
          <% end %>
        </div>
      <% else %>
        <a class="button button-wide" href="#availability">See open times</a>
      <% end %>
    </aside>
  </div>

  <section id="availability" class="availability" aria-labelledby="availability-heading">
    <div class="section-heading">
      <h2 id="availability-heading">Availability</h2>
      <ul class="calendar-legend" aria-label="Legend">
        <li><span class="swatch swatch-open"></span> Open</li>
        <li><span class="swatch swatch-pending"></span> Requested</li>
        <li><span class="swatch swatch-booked"></span> Booked</li>
        <li><span class="swatch swatch-today"></span> Today</li>
      </ul>
    </div>
    <p class="availability-hint">Choose a day to see its time slots.<% if current_user && !@location.hosted_by?(current_user) %> Select a slot, or a run of slots, then send your request.<% end %></p>

    <%= turbo_frame_tag "bookings_calendar" do %>
      <% pickable = current_user.present? && !@location.hosted_by?(current_user) %>
      <% month_start = calendar_month_start(params[:start_date]) %>
      <% visible_days = (month_start.beginning_of_week..month_start.end_of_month.end_of_week) %>
      <% schedules = visible_days.select { |d| d >= Date.current }.index_with { |d| @location.schedule_for(d, @bookings) } %>

      <div class="availability-layout" data-controller="booking-picker"
           data-booking-picker-selected-date-value="<%= @selected_date&.iso8601 %>">
        <div class="availability-calendar">
          <%= month_calendar(events: @bookings, attribute: :started_at, end_attribute: :ended_at) do |date, _bookings| %>
            <% schedule = schedules[date] %>
            <% if schedule %>
              <button type="button" class="day-pick" data-action="booking-picker#showDay"
                      data-booking-picker-date-param="<%= date.iso8601 %>"
                      aria-label="See time slots on <%= l(date, format: "%A, %B %-d") %>"></button>
            <% end %>
            <span class="day-number"><%= date.day %></span>
            <% if schedule %>
              <% open_count = schedule.count(&:open?) %>
              <% if @location.hours_for(date).nil? %>
                <span class="day-status day-closed">Closed</span>
              <% elsif open_count.positive? %>
                <span class="day-status day-open"><%= open_count %> open</span>
              <% elsif schedule.any? { |slot| %i[booked requested].include?(slot.state) } %>
                <span class="day-status day-full">Booked up</span>
              <% else %>
                <span class="day-status day-closed">Done for today</span>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <aside class="day-panel" aria-live="polite">
          <p class="day-placeholder" data-booking-picker-target="placeholder">Choose a day on the calendar to see its time slots.</p>

          <% schedules.each do |date, schedule| %>
            <%= render "locations/day_view", location: @location, date: date, schedule: schedule, pickable: pickable %>
          <% end %>

          <% if pickable %>
            <%= form_with url: bookings_path, scope: :booking, class: "slot-request", data: { turbo: false } do |form| %>
              <%= form.hidden_field :location_id, value: @location.id %>
              <%= form.hidden_field :started_at, data: { booking_picker_target: "startInput" } %>
              <%= form.hidden_field :ended_at, data: { booking_picker_target: "endInput" } %>
              <p class="selection-summary" data-booking-picker-target="summary">No time selected yet.</p>
              <%= form.submit "Request Booking", class: "button button-wide", disabled: true, data: { booking_picker_target: "submit" } %>
              <p class="form-hint">The host confirms or declines your request. You can cancel any time before it starts.</p>
            <% end %>
          <% elsif current_user.nil? %>
            <p class="day-panel-note"><%= link_to "Log in", new_user_session_path %> or <%= link_to "sign up", new_user_registration_path %> to request a booking.</p>
          <% end %>
        </aside>
      </div>
    <% end %>
  </section>

  <p class="back-link"><%= link_to "Back to all locations", locations_path %></p>
</article>

<script>
  (function () {
    const mapElement = document.getElementById("map");
    if (!mapElement) return;

    const token = mapElement.dataset.mapboxToken;
    const address = mapElement.dataset.address;

    const unavailable = (message) => {
      mapElement.classList.add("is-unavailable");
      mapElement.innerHTML = `<p class="map-error">${message}</p>`;
    };

    if (!token || !address || !window.mapboxgl) {
      unavailable("Map isn't available for this location.");
      return;
    }

    mapboxgl.accessToken = token;
    const geocodeUrl = `https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(address)}.json?access_token=${token}&limit=1`;

    fetch(geocodeUrl)
      .then((response) => response.ok ? response.json() : Promise.reject(response))
      .then((data) => {
        const feature = data.features && data.features[0];
        if (!feature) throw new Error("No geocode result");

        const [lng, lat] = feature.center;
        const map = new mapboxgl.Map({ container: "map", style: "mapbox://styles/mapbox/standard", zoom: 13, center: [lng, lat] });
        map.addControl(new mapboxgl.NavigationControl());
        new mapboxgl.Marker({ color: "#0F6B5C" }).setLngLat([lng, lat]).addTo(map);
      })
      .catch(() => unavailable("Couldn't load the map for this address."));
  })();
</script>
