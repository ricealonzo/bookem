{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "/new$",
        "/edit$",
        "/users/sign_in$",
        "/users/sign_up$",
        "/users/password/new$"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/$",
        "^/locations$"
      ],
      "properties": {
        "presentation": "clear_all"
      }
    }
  ]
}
