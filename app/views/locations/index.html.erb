<% content_for :title, "Locations" %>

<section class="hero">
  <div class="hero-copy">
    <h1>Book time at the places down the street.</h1>
    <p class="hero-lede">
      Studios, salons, barbershops and event spaces run by local owners.
      Pick a time, send a request, and the host confirms it.
    </p>
    <div class="hero-actions">
      <a class="button" href="#locations">Browse locations</a>
      <%= link_to "List your space", new_location_path, class: "button button-quiet" %>
    </div>
  </div>

  <figure class="hero-media">
    <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"
           poster="<%= asset_path("spaces_reel_poster.jpg") %>">
      <source src="<%= asset_path("spaces_reel.mp4") %>" type="video/mp4">
    </video>
  </figure>
</section>

<section class="how-it-works" aria-labelledby="how-heading">
  <h2 id="how-heading">How booking works</h2>
  <ol>
    <li>
      <h3>Find a space</h3>
      <p>Browse photos, details and open times for each location.</p>
    </li>
    <li>
      <h3>Request a time</h3>
      <p>Choose a start and end. Taken times are shown on the calendar.</p>
    </li>
    <li>
      <h3>Get confirmed</h3>
      <p>The host confirms or declines, and you'll see it on your Bookings page.</p>
    </li>
  </ol>
</section>

<section id="locations" class="locations" aria-labelledby="locations-heading">
  <div class="section-heading">
    <h2 id="locations-heading">Places to book</h2>
    <p><%= pluralize(@locations.size, "location") %></p>
  </div>

  <% if @locations.any? %>
    <ul class="location-grid">
      <% @locations.each do |location| %>
        <li><%= render "locations/location_card", location: location %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">No locations yet. <%= link_to "List the first one", new_location_path %>.</p>
  <% end %>
</section>
