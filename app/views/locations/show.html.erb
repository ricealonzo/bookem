
  
  <h1><%= @location.name  %></h1>



<div class="location_show_container">

  <%= render @location %>

  <% full_address = @location.full_address %>
  <div class="mt-3">
    <h2>Map</h2>
    <p class="location-address"><%= full_address.presence || "Address unavailable" %></p>
    <div
      id="map"
      class="location-map"
      data-address="<%= full_address %>"
      data-mapbox-token="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN", "") %>">
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const mapElement = document.getElementById("map");
    if (!mapElement) return;

    const token = mapElement.dataset.mapboxToken;
    const address = mapElement.dataset.address;

    if (!token || !address) {
      mapElement.innerHTML = "<p class=\"map-error\">Map is unavailable.</p>";
      return;
    }

    mapboxgl.accessToken = token;

    const geocodeUrl = `https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(address)}.json?access_token=${token}&limit=1`;

    fetch(geocodeUrl)
      .then((response) => response.ok ? response.json() : Promise.reject(response))
      .then((data) => {
        const feature = data.features && data.features[0];
        if (!feature) throw new Error("No geocode result");

        const [lng, lat] = feature.center;
        const map = new mapboxgl.Map({
          container: "map",
          style: "mapbox://styles/mapbox/standard",
          zoom: 12,
          center: [lng, lat]
        });

        map.addControl(new mapboxgl.NavigationControl());
        new mapboxgl.Marker().setLngLat([lng, lat]).addTo(map);
      })
      .catch(() => {
        mapElement.innerHTML = "<p class=\"map-error\">Unable to load the map for this address.</p>";
      });
  });
</script>
<section class="location_booking">
  <% if current_user.nil? %>
    <h2>Book Now</h2>
    <p><%= link_to "Log in", new_user_session_path %> or <%= link_to "sign up", new_user_registration_path %> to request a booking.</p>
  <% elsif @location.hosted_by?(current_user) %>
    <h2>Your Location</h2>
    <p>Guests' requests show up on your <%= link_to "Bookings", bookings_path %> page, where you can confirm or decline them.</p>
  <% else %>
    <%= render "bookings/form", booking: @booking %>
  <% end %>
</section>

<h2>Availability</h2>
<p class="calendar-legend">Booked and requested times are blocked. Pick a time that doesn't overlap them.</p>

<%= turbo_frame_tag "bookings_calendar" do %>
  <%= month_calendar(events: @bookings, attribute: :started_at, end_attribute: :ended_at) do |date, bookings| %>
    <div class="day">
      <div class="fw-bold"><%= date.day %></div>

      <% bookings.each do |booking| %>
        <% involved = current_user && (booking.guest_id == current_user.id || @location.hosted_by?(current_user)) %>
        <div class="card-sm text-truncate calendar-booking calendar-booking-<%= booking.status %>">
          <div class="card-header">
            <div class="card-title">
              <% if involved %>
                <%= link_to booking.guest.full_name.presence || "Guest", booking, data: { turbo_frame: "_top" } %>
              <% else %>
                <%= booking.confirmed? ? "Booked" : "Requested" %>
              <% end %>
            </div>
          </div>

          <div class="card-footer">
            <p class="card-text"><%= booking.started_at.strftime("%-I:%M %p") %>–<%= booking.ended_at.strftime("%-I:%M %p") %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="location_actions">
  <%= link_to "Back to locations", locations_path %>

  <% if policy(@location).update? %>
    | <%= link_to "Edit this location", edit_location_path(@location) %>
  <% end %>
  <% if policy(@location).destroy? %>
    <%= button_to "Delete this location", @location, method: :delete, form: { data: { turbo_confirm: "Delete this location and all its bookings?" } } %>
  <% end %>
</div>
